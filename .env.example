# Firebase web app settings for cloud saves (Firebase console > Project settings >
# Your apps > Web app). Set the same names in Vercel > Settings > Environment
# Variables. Leave them out and the game runs with local saves only.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
